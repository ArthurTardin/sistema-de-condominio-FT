plantuml
@startuml
title Diagrama de Casos de Uso - IoT e Controle de Acesso

skinparam backgroundColor #0f172a
skinparam defaultTextAlignment center
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype ortho
skinparam ArrowColor #94a3b8
skinparam ActorFontColor #f8fafc
skinparam UsecaseFontColor #f8fafc
skinparam PackageFontColor #f8fafc

skinparam actor {
  BackgroundColor #1e293b
  BorderColor #475569
  FontColor #f8fafc
}

skinparam usecase {
  BackgroundColor #1e293b
  BorderColor #475569
  FontColor #f8fafc
}

skinparam rectangle {
  BackgroundColor #0f172a
  BorderColor #475569
  FontColor #f8fafc
}

left to right direction

actor "Administrador" as Administrador
actor "Funcionário" as Funcionario
actor "Morador" as Morador
actor "Sistema" as Sistema
actor "Dispositivo IoT" as IoT

rectangle "Sistema de Gestão Condominial - IoT e Acesso" {

  package "Gestão de Dispositivos IoT" {
    usecase "Cadastrar Dispositivo" as UC01
    usecase "Consultar Dispositivos" as UC02
    usecase "Atualizar Configuração do Dispositivo" as UC03
    usecase "Inativar Dispositivo" as UC04
    usecase "Consultar Estado de Conectividade" as UC05
  }

  package "Telemetria e Alarmes" {
    usecase "Receber Telemetria MQTT" as UC06
    usecase "Consultar Telemetria" as UC07
    usecase "Avaliar Limites de Telemetria" as UC08
    usecase "Detectar Anomalia ou Falha" as UC09
    usecase "Gerar Alarme IoT" as UC10
    usecase "Gerar Chamado Automático" as UC11
  }

  package "Credenciais e Autorizações" {
    usecase "Gerenciar Credenciais de Acesso" as UC12
    usecase "Gerenciar Autorizações de Acesso" as UC13
    usecase "Gerar Autorização para Reserva Confirmada" as UC14
    usecase "Sincronizar Autorizações com Dispositivo" as UC15
    usecase "Revogar ou Expirar Autorização" as UC16
  }

  package "Execução do Controle de Acesso" {
    usecase "Validar Credencial" as UC17
    usecase "Validar Autorização de Acesso" as UC18
    usecase "Conceder ou Negar Acesso" as UC19
    usecase "Registrar Evento de Acesso" as UC20
    usecase "Consultar Registros de Acesso" as UC21
  }
}

' Administrador
Administrador --> UC01
Administrador --> UC02
Administrador --> UC03
Administrador --> UC04
Administrador --> UC05
Administrador --> UC07
Administrador --> UC12
Administrador --> UC13
Administrador --> UC21

' Funcionário
Funcionario --> UC02
Funcionario --> UC05
Funcionario --> UC07
Funcionario --> UC21

' Morador
Morador --> UC12

' Dispositivo IoT
IoT --> UC06
IoT --> UC15
IoT --> UC17
IoT --> UC19
IoT --> UC20

' Sistema
Sistema --> UC08
Sistema --> UC09
Sistema --> UC10
Sistema --> UC11
Sistema --> UC14
Sistema --> UC16

' Comportamentos obrigatórios
UC06 ..> UC08 : <<include>>
UC08 ..> UC09 : <<include>>
UC09 ..> UC10 : <<include>>
UC10 ..> UC11 : <<extend>>

UC14 ..> UC15 : <<include>>
UC17 ..> UC18 : <<include>>
UC18 ..> UC19 : <<include>>
UC19 ..> UC20 : <<include>>

note right of UC06
  A comunicação ocorre por MQTT.
  Os tópicos devem respeitar
  o padrão definido na especificação
  de integração e o isolamento
  por condomínio.
end note

note right of UC10
  Alarmes devem respeitar as regras
  de detecção, limites, deduplicação
  e correlação definidas no projeto.
end note

note right of UC14
  A autorização deve estar vinculada
  à reserva e à credencial aplicável,
  com validade e dispositivo definidos
  conforme as regras de acesso.
end note

note right of UC15
  Estado lógico da autorização:
  Ativa, Expirada ou Revogada.

  Estado de sincronização:
  Pendente, Sincronizado ou Falhou.
end note

note bottom of UC19
  Em caso de indisponibilidade,
  a decisão local deve seguir
  a política de contingência
  e os limites de validade
  previamente definidos.
end note

note bottom of UC20
  O registro de acesso deve preservar
  o evento conforme as regras de
  integridade, auditoria e retenção.
end note

@enduml