plantuml
@startuml
title Diagrama de Casos de Uso - Chamados

skinparam backgroundColor #0f172a
skinparam defaultTextAlignment center
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype ortho
skinparam ArrowColor #94a3b8
skinparam ActorFontColor #f8fafc
skinparam UsecaseFontColor #f8fafc
skinparam PackageFontColor #f8fafc

skinparam actor {
  BackgroundColor #1e293b
  BorderColor #475569
  FontColor #f8fafc
}

skinparam usecase {
  BackgroundColor #1e293b
  BorderColor #475569
  FontColor #f8fafc
}

skinparam rectangle {
  BackgroundColor #0f172a
  BorderColor #475569
  FontColor #f8fafc
}

left to right direction

actor "Morador" as Morador
actor "Funcionário" as Funcionario
actor "Administrador" as Administrador
actor "Sistema" as Sistema
actor "Dispositivo IoT" as IoT

rectangle "Sistema de Gestão Condominial - Chamados" {

  package "Abertura e Consulta" {
    usecase "Abrir Chamado" as UC01
    usecase "Consultar Chamados" as UC02
    usecase "Consultar Detalhes do Chamado" as UC03
    usecase "Consultar Histórico do Chamado" as UC04
  }

  package "Gerenciamento de Chamados" {
    usecase "Atribuir Chamado" as UC05
    usecase "Gerenciar Chamado" as UC06
    usecase "Alterar Estado do Chamado" as UC07
    usecase "Registrar Comentário ou Atualização" as UC08
  }

  package "Acompanhamento Operacional" {
    usecase "Acompanhar SLA" as UC09
    usecase "Monitorar SLA Automaticamente" as UC10
    usecase "Registrar Violação de SLA" as UC11
  }

  package "Processamento Automático" {
    usecase "Controlar Ciclo de Vida do Chamado" as UC12
    usecase "Gerar Chamado por Alarme IoT" as UC13
    usecase "Registrar Histórico de Alterações" as UC14
    usecase "Notificar Interessados" as UC15
  }
}

' Morador
Morador --> UC01
Morador --> UC02
Morador --> UC03
Morador --> UC04

' Funcionário
Funcionario --> UC02
Funcionario --> UC03
Funcionario --> UC04
Funcionario --> UC06
Funcionario --> UC07
Funcionario --> UC08
Funcionario --> UC09

' Administrador
Administrador --> UC01
Administrador --> UC02
Administrador --> UC03
Administrador --> UC04
Administrador --> UC05
Administrador --> UC06
Administrador --> UC07
Administrador --> UC08
Administrador --> UC09

' Sistema
Sistema --> UC10
Sistema --> UC11
Sistema --> UC12
Sistema --> UC14
Sistema --> UC15

' Dispositivo IoT
IoT --> UC13

' Comportamentos associados ao gerenciamento
UC06 ..> UC07 : <<include>>
UC07 ..> UC14 : <<include>>
UC13 ..> UC14 : <<include>>

note right of UC06
  Tipos de chamado:
  - Manutencao
  - AlarmeIoT
end note

note right of UC12
  Estados previstos:
  - Aberto
  - Atribuido
  - EmAndamento
  - AguardandoPecaTerceiro
  - Resolvido
  - Fechado
  - Cancelado

  As transições permitidas e suas
  condições devem seguir as regras
  de negócio documentadas.
end note

note bottom of UC14
  O histórico é append-only durante
  a operação normal e registra,
  conforme definido nos requisitos,
  o estado anterior, o novo estado,
  o responsável, a data e hora
  e um comentário opcional.
end note

note bottom of UC13
  O chamado automático é gerado
  a partir de um alarme IoT conforme
  as regras de detecção e correlação
  definidas para a integração.
end note

@enduml