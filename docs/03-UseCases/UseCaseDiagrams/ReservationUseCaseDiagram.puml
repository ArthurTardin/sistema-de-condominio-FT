@startuml
title Diagrama de Casos de Uso - Reservas

skinparam backgroundColor #0f172a
skinparam defaultTextAlignment center
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype ortho
skinparam ArrowColor #94a3b8

skinparam actor {
  BackgroundColor #1e293b
  BorderColor #475569
  FontColor #f8fafc
}

skinparam usecase {
  BackgroundColor #1e293b
  BorderColor #475569
  FontColor #f8fafc
}

skinparam rectangle {
  BackgroundColor #0f172a
  BorderColor #475569
  FontColor #f8fafc
}

left to right direction

actor "Morador" as Morador
actor "Administrador" as Administrador
actor "Sistema" as Sistema

rectangle "Sistema de Gestão Condominial - Reservas" {

  package "Consulta" {
    usecase "Consultar Espaços Comuns" as UC01
    usecase "Consultar Disponibilidade" as UC02
    usecase "Consultar Próprias Reservas" as UC03
    usecase "Consultar Reservas do Condomínio" as UC04
  }

  package "Operações de Reserva" {
    usecase "Realizar Reserva" as UC05
    usecase "Cancelar Reserva" as UC06
    usecase "Validar Solicitação de Reserva" as UC07
    usecase "Verificar Disponibilidade" as UC08
    usecase "Validar Elegibilidade do Usuário" as UC09
    usecase "Verificar Restrições de Inadimplência" as UC10
  }

  package "Configuração e Operação" {
    usecase "Gerenciar Espaços Comuns" as UC11
    usecase "Configurar Regras de Reserva" as UC12
    usecase "Alterar Estado Operacional do Espaço" as UC13
  }

  package "Processamento Automático" {
    usecase "Processar Expiração da Reserva" as UC14
    usecase "Liberar Disponibilidade" as UC15
    usecase "Gerar Autorização de Acesso" as UC16
  }
}

' Morador
Morador --> UC01
Morador --> UC02
Morador --> UC03
Morador --> UC05
Morador --> UC06

' Administrador
Administrador --> UC01
Administrador --> UC02
Administrador --> UC04
Administrador --> UC11
Administrador --> UC12
Administrador --> UC13
Administrador --> UC06

' Sistema
Sistema --> UC14
Sistema --> UC15
Sistema --> UC16

' Relacionamentos de inclusão
UC05 ..> UC07 : <<include>>
UC07 ..> UC08 : <<include>>
UC07 ..> UC09 : <<include>>
UC07 ..> UC10 : <<include>>

note right of UC10
  Aplicar somente as restrições
  de inadimplência definidas
  nos requisitos e regras de negócio.
end note

note right of UC16
  A autorização de acesso depende
  das condições definidas para
  a reserva confirmada.
end note

note bottom of UC14
  O gatilho, os estados finais
  e as regras de expiração devem
  seguir os requisitos funcionais.
end note

@enduml