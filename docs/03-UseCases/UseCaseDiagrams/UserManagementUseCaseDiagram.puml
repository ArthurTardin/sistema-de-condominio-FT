plantuml
@startuml
title Diagrama de Casos de Uso - Usuários e Unidades

skinparam backgroundColor #0f172a
skinparam defaultTextAlignment center
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype ortho
skinparam ArrowColor #94a3b8
skinparam ActorFontColor #f8fafc
skinparam UsecaseFontColor #f8fafc
skinparam PackageFontColor #f8fafc

skinparam actor {
  BackgroundColor #1e293b
  BorderColor #475569
  FontColor #f8fafc
}

skinparam usecase {
  BackgroundColor #1e293b
  BorderColor #475569
  FontColor #f8fafc
}

skinparam rectangle {
  BackgroundColor #0f172a
  BorderColor #475569
  FontColor #f8fafc
}

left to right direction

actor "Morador" as Morador
actor "Funcionário" as Funcionario
actor "Administrador" as Administrador
actor "Master" as Master

rectangle "Sistema de Gestão Condominial - Usuários e Unidades" {

  package "Conta do Usuário" {
    usecase "Consultar Dados da Conta" as UC01
    usecase "Atualizar Dados da Conta" as UC02
    usecase "Alterar Senha" as UC03
    usecase "Consultar Vínculos com Unidades" as UC04
  }

  package "Gestão de Usuários do Condomínio" {
    usecase "Consultar Usuários" as UC05
    usecase "Cadastrar Usuário" as UC06
    usecase "Atualizar Usuário" as UC07
    usecase "Inativar Usuário" as UC08
    usecase "Gerenciar Vínculos com Unidades" as UC09
    usecase "Definir Tipo de Vínculo" as UC10
  }

  package "Gestão de Unidades" {
    usecase "Consultar Unidades" as UC11
    usecase "Cadastrar Unidade" as UC12
    usecase "Atualizar Unidade" as UC13
    usecase "Inativar Unidade" as UC14
    usecase "Consultar Ocupantes da Unidade" as UC15
  }

  package "Controle de Acesso e Integridade" {
    usecase "Validar Permissões" as UC16
    usecase "Validar Contexto do Condomínio" as UC17
    usecase "Preservar Histórico Operacional" as UC18
  }
}

' Morador
Morador --> UC01
Morador --> UC02
Morador --> UC03
Morador --> UC04
Morador --> UC11

' Funcionário
Funcionario --> UC05
Funcionario --> UC11
Funcionario --> UC15

' Administrador
Administrador --> UC05
Administrador --> UC06
Administrador --> UC07
Administrador --> UC08
Administrador --> UC09
Administrador --> UC10
Administrador --> UC11
Administrador --> UC12
Administrador --> UC13
Administrador --> UC14
Administrador --> UC15

' Master
Master --> UC05

' Relacionamentos obrigatórios
UC09 ..> UC10 : <<include>>
UC06 ..> UC16 : <<include>>
UC07 ..> UC16 : <<include>>
UC08 ..> UC16 : <<include>>
UC09 ..> UC17 : <<include>>
UC12 ..> UC17 : <<include>>
UC13 ..> UC17 : <<include>>
UC08 ..> UC18 : <<include>>
UC14 ..> UC18 : <<include>>

note right of UC10
  Tipos de vínculo previstos:
  - Proprietario
  - Inquilino
  - Dependente
end note

note right of UC17
  Usuários e unidades devem
  respeitar o TenantID e as
  regras de isolamento entre
  condomínios.
end note

note bottom of UC18
  A inativação deve respeitar
  as regras de exclusão lógica
  e preservação dos registros
  históricos e operacionais.
end note

@enduml