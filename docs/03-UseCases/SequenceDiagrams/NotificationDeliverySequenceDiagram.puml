@startuml NotificationDeliverySequenceDiagram
title Diagrama de Sequência — Entrega de Notificações

skinparam backgroundColor #0f172a
skinparam sequence {
    BackgroundColor #0f172a
    ArrowColor #94a3b8
    ActorBackgroundColor #1e293b
    ActorBorderColor #475569
    ActorFontColor #f8fafc
    ParticipantBackgroundColor #1e293b
    ParticipantBorderColor #475569
    ParticipantFontColor #f8fafc
    LifeLineBorderColor #475569
    LifeLineBackgroundColor #1e293b
    BoxBackgroundColor #0f172a
    BoxBorderColor #475569
}
skinparam defaultFontColor #f8fafc
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

participant "Módulo de Origem" as Source
participant "NotificationService" as Notification
participant "AuthService" as Auth
database "Banco de Dados" as DB
participant "NotificationWorker" as Worker
participant "Canal de Entrega" as Channel
actor "Destinatário" as Recipient

== Criação da notificação ==

Source -> Notification : Solicitar criação da notificação
Notification -> Notification : Validar conteúdo, tipo e destinatários
Notification -> DB : Validar destinatários e escopo do tenant
DB --> Notification : Resultado da validação

alt Solicitação inválida
    Notification --> Source : Rejeitar solicitação
else Solicitação válida
    Notification -> DB : Persistir notificação com estado pendente
    DB --> Notification : Notificação persistida
    Notification --> Source : Notificação registrada
end

== Preparação e envio ==

Worker -> DB : Buscar notificações pendentes
DB --> Worker : Notificações disponíveis

loop Para cada notificação elegível
    Worker -> Notification : Processar notificação
    Notification -> DB : Consultar dados necessários\ne verificar estado atual
    DB --> Notification : Dados e estado da notificação

    alt Notificação cancelada ou inelegível
        Notification -> DB : Registrar resultado do processamento
        DB --> Notification : Resultado persistido
    else Notificação elegível
        Notification -> Channel : Solicitar entrega ao destinatário
        Channel --> Notification : Resultado da tentativa

        alt Canal confirma entrega
            Notification -> DB : Atualizar estado para entregue\nconforme confirmação válida
            DB --> Notification : Estado atualizado
        else Canal aceita a solicitação, sem confirmar entrega
            Notification -> DB : Registrar envio solicitado\nou aguardando confirmação
            DB --> Notification : Estado atualizado
        else Falha temporária
            Notification -> DB : Registrar falha e próxima tentativa\nconforme política de retentativa
            DB --> Notification : Falha registrada
        else Falha permanente
            Notification -> DB : Registrar falha definitiva
            DB --> Notification : Falha registrada
        end
    end
end

== Consulta pelo destinatário ==

Recipient -> API : Solicitar notificações
API -> Auth : Validar token e contexto do usuário
Auth --> API : Identidade e tenant autorizados

alt Usuário não autenticado
    API --> Recipient : 401 Unauthorized
else Usuário autenticado
    API -> Notification : Consultar notificações do destinatário
    Notification -> DB : Buscar notificações no escopo autorizado
    DB --> Notification : Lista de notificações
    Notification --> API : Lista e estados
    API --> Recipient : 200 OK — Notificações
end

== Marcação como lida ==

Recipient -> API : Marcar notificação como lida
API -> Auth : Validar token e contexto do usuário
Auth --> API : Identidade e tenant autorizados

alt Usuário não autenticado
    API --> Recipient : 401 Unauthorized
else Usuário autenticado
    API -> Notification : Marcar como lida
    Notification -> DB : Buscar notificação e validar destinatário
    DB --> Notification : Resultado da consulta

    alt Notificação inexistente ou de outro destinatário
        Notification --> API : Notificação não encontrada
        API --> Recipient : 404 Not Found
    else Notificação autorizada
        Notification -> DB : Persistir estado de leitura
        DB --> Notification : Estado atualizado
        Notification --> API : Notificação marcada como lida
        API --> Recipient : 200 OK
    end
end

@enduml