@startuml AccessEventProcessingSequenceDiagram
title Diagrama de Sequência — Processamento de Eventos de Acesso

skinparam backgroundColor #0f172a
skinparam sequence {
    BackgroundColor #0f172a
    ArrowColor #94a3b8
    ActorBackgroundColor #1e293b
    ActorBorderColor #475569
    ActorFontColor #f8fafc
    ParticipantBackgroundColor #1e293b
    ParticipantBorderColor #475569
    ParticipantFontColor #f8fafc
    LifeLineBorderColor #475569
    LifeLineBackgroundColor #1e293b
    BoxBackgroundColor #0f172a
    BoxBorderColor #475569
}
skinparam defaultFontColor #f8fafc
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

participant "Dispositivo de Acesso" as Device
participant "MQTT Broker" as MQTT
participant "AccessEventConsumer" as Consumer
participant "IoTDeviceService" as DeviceService
participant "AccessAuthorizationService" as Authorization
database "Banco de Dados" as DB
participant "NotificationService" as Notification

== Recebimento do evento ==

Device -> MQTT : Publicar evento de acesso
MQTT -> Consumer : Entregar mensagem

Consumer -> DeviceService : Validar identidade e autorização\ndo dispositivo
DeviceService -> DB : Consultar dispositivo registrado,\nativo e vinculado ao tenant
DB --> DeviceService : Resultado da validação
DeviceService --> Consumer : Resultado da autorização

alt Dispositivo inválido ou não autorizado
    Consumer -> Consumer : Rejeitar mensagem e registrar falha
else Dispositivo autorizado
    Consumer -> Consumer : Validar formato e identificador\ndo evento

    alt Evento inválido
        Consumer -> Consumer : Rejeitar mensagem e registrar erro
    else Evento válido
        Consumer -> DB : Verificar idempotência do evento
        DB --> Consumer : Resultado da consulta

        alt Evento já processado
            Consumer --> MQTT : Reconhecer ou descartar duplicata\nconforme política de consumo
        else Evento novo
            Consumer -> Authorization : Correlacionar evento com autorização
            Authorization -> DB : Consultar autorização aplicável,\nstatus lógico e vínculo com o tenant
            DB --> Authorization : Dados da autorização

            alt Autorização identificada
                Authorization -> Authorization : Avaliar validade no momento\ndo evento e contexto do acesso
                Authorization --> Consumer : Resultado da avaliação
            else Nenhuma autorização correspondente
                Authorization --> Consumer : Evento sem autorização correspondente
            end

            Consumer -> DB : Persistir RegistroAcesso com os dados\ndo evento e o resultado informado
            DB --> Consumer : Registro de acesso persistido

            opt Evento exige notificação conforme regras
                Consumer -> Notification : Solicitar notificação de acesso
                Notification --> Consumer : Solicitação processada
            end

            Consumer --> MQTT : Confirmar processamento
        end
    end
end

== Consulta do histórico de acessos ==

actor Administrador
participant "API" as API
participant "AuthService" as Auth
participant "AccessEventService" as AccessService

Administrador -> API : Consultar histórico de acessos
API -> Auth : Validar token, perfil e tenant
Auth --> API : Resultado da autorização

alt Usuário não autorizado
    API --> Administrador : 401/403 — Acesso negado
else Usuário autorizado
    API -> AccessService : Consultar registros de acesso
    AccessService -> DB : Buscar RegistroAcesso no escopo\ndo tenant e dos filtros autorizados
    DB --> AccessService : Registros encontrados
    AccessService --> API : Histórico de acessos
    API --> Administrador : 200 OK — Histórico consultado
end

@enduml