plantuml
@startuml
title Diagrama de Atividades - Realização de Reserva

skinparam backgroundColor #0f172a
skinparam shadowing false
skinparam ArrowColor #94a3b8
skinparam ActivityBackgroundColor #1e293b
skinparam ActivityBorderColor #475569
skinparam ActivityFontColor #f8fafc
skinparam ActivityDiamondBackgroundColor #334155
skinparam ActivityDiamondBorderColor #64748b
skinparam ActivityDiamondFontColor #f8fafc
skinparam PartitionBackgroundColor #0f172a
skinparam PartitionBorderColor #475569
skinparam PartitionFontColor #f8fafc

start

partition "Morador" {
  :Acessar a funcionalidade de reservas;
  :Consultar espaços disponíveis;
  :Selecionar espaço, data e horário;
  :Enviar solicitação de reserva;
}

partition "Backend" {
  :Autenticar e identificar o usuário;
  :Validar contexto do condomínio;
  
  if (Usuário autorizado?) then (Sim)
  else (Não)
    :Rejeitar solicitação;
    :Informar falta de autorização;
    stop
  endif

  :Validar dados da solicitação;

  if (Solicitação válida?) then (Sim)
  else (Não)
    :Informar dados inválidos;
    stop
  endif

  :Verificar elegibilidade do usuário;

  if (Usuário elegível?) then (Sim)
  else (Não)
    :Rejeitar solicitação;
    :Informar motivo da rejeição;
    stop
  endif

  :Aplicar regras de inadimplência;

  if (Reserva permitida pelas regras financeiras?) then (Sim)
  else (Não)
    :Rejeitar solicitação;
    :Informar restrição aplicável;
    stop
  endif

  :Verificar estado operacional do espaço;
  
  if (Espaço disponível para uso?) then (Sim)
  else (Não)
    :Rejeitar solicitação;
    :Informar indisponibilidade do espaço;
    stop
  endif

  :Verificar disponibilidade do horário;

  if (Horário disponível?) then (Sim)
  else (Não)
    :Rejeitar solicitação;
    :Informar conflito de horário;
    stop
  endif

  :Validar regras de antecedência\ne duração da reserva;
  
  if (Regras de reserva atendidas?) then (Sim)
  else (Não)
    :Rejeitar solicitação;
    :Informar regra não atendida;
    stop
  endif

  :Tentar registrar reserva\ncom proteção contra concorrência;

  if (Registro confirmado pelo banco?) then (Sim)
    :Persistir reserva confirmada;
  else (Não)
    :Tratar conflito ou falha;
    :Informar que a reserva\nnão foi confirmada;
    stop
  endif
}

partition "Integração de Acesso" {
  :Verificar se a reserva exige\nautorização de acesso;

  if (Autorização necessária?) then (Sim)
    :Gerar autorização vinculada\nà reserva e à credencial;
    :Registrar estado de sincronização;

    if (Dispositivo sincronizado?) then (Sim)
      :Registrar sincronização concluída;
    else (Não)
      :Manter sincronização pendente\nou registrar falha;
    endif
  else (Não)
    :Não gerar autorização de acesso;
  endif
}

partition "Backend" {
  :Agendar notificações aplicáveis;
  :Registrar eventos de auditoria;
}

partition "Morador" {
  :Receber resultado da solicitação;
  :Consultar reserva confirmada;
}

stop

@enduml